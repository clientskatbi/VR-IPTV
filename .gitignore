# Godot
.import/
addons/*/.import/
addons/*/plugin.cfg.*
addons/*/*.translation

# Large vendor binaries (Meta OpenXR native libs + Android export templates)
addons/godotopenxrvendors/.bin/
Library/Application Support/Godot/export_templates/

# Generated
export/
build/
*.apk
*.aab

# Editor
.godot/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local
*.keystore
secrets.properties
local.properties

# Android source template (modified for INTERNET permission)
# Track src/main/AndroidManifest.xml, ignore build artifacts
android/build/
android/.gradle/
android/app/build/
android/.idea/
android/local.properties

# Editor backup files
*.bak

# Godot Android lib binaries (downloaded by CI)
android/libs/
android/libs/debug/
android/libs/release/

# Android instrumented test infrastructure (not needed for production build)
android/src/instrumented/
android/src/androidTestInstrumented/
android/assetPackInstallTime/
